# IndexTTS2 ARM64 Dockerfile for NVIDIA DGX GB10 / DGX Spark.
# The image uses CUDA 13 and the Linux aarch64 PyTorch CUDA wheel set.

FROM --platform=linux/arm64 nvidia/cuda:13.0.2-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV HF_ENDPOINT=https://hf-mirror.com
ENV PATH="/root/.local/bin:$PATH"
ENV UV_CACHE_DIR=/tmp/uv-cache
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    ffmpeg \
    git \
    libgomp1 \
    libsndfile1 \
    python3.12 \
    python3.12-dev \
    python3.12-venv \
    python3-pip \
    tini \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

COPY . /app

# Do not install DeepSpeed on GB10. Keep BigVGAN on the pure torch fallback
# path by leaving --use_cuda_kernel disabled in the runtime command.
RUN uv sync --locked --python /usr/bin/python3.12 --extra webui --no-dev \
    --default-index "https://mirrors.aliyun.com/pypi/simple" \
    && uv run --locked --extra webui --no-dev python -c "import platform, torch, torchaudio, gradio; print(platform.machine(), torch.__version__, torch.version.cuda, torchaudio.__version__, gradio.__version__)"

EXPOSE 8002

ENTRYPOINT ["tini", "--"]
CMD ["uv", "run", "--locked", "--extra", "webui", "--no-dev", "python", "api_server.py", "--host", "0.0.0.0", "--port", "8002", "--fp16"]
